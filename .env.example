# Server-only credentials from your Vercel-connected Upstash Redis database.
# Never prefix these with VITE_. KV_REST_API_URL/TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase web app configuration (public values from Firebase project settings).
# Enable only Google in Authentication > Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional destinations for the profile Feedback and Rate Us panels.
VITE_FEEDBACK_EMAIL=
VITE_APP_REVIEW_URL=

# Native Google map and Google Places nearby mosque search.
# Enable Maps JavaScript API + Places API (New) and billing in Google Cloud.
# Restrict this public browser key to your website domains and those APIs.
# Without a key the finder uses OpenStreetMap with the same GPS-first 1 km flow.
VITE_GOOGLE_MAPS_API_KEY=
# Optional production map ID for Advanced Markers; demo ID is used during development.
VITE_GOOGLE_MAPS_MAP_ID=

