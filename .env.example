# Server-only credentials from your Vercel-connected Upstash Redis database.
# Never prefix these with VITE_. KV_REST_API_URL/TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase web app configuration (public values from Firebase project settings).
# Enable only Google in Authentication > Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
